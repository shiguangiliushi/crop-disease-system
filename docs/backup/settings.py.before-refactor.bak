            'backupCount': 3,  # 保留 3 个备份
            'encoding': 'utf-8',  # 编码
            'formatter': 'verbose',  # 使用详细格式
        },
    },
    'root': {  # 根日志记录器
        'handlers': ['console', 'file'],  # 使用控制台和文件处理器
        'level': 'INFO',  # 信息级别
    },
    'loggers': {  # 日志记录器配置
        'django': {  # Django日志记录器
            'handlers': ['console', 'file'],  # 使用控制台和文件处理器
            'level': 'INFO',  # 信息级别
            'propagate': False,  # 不传播
        },
        'django.request': {  # Django请求日志记录器
