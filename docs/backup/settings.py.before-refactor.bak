            'level': 'DEBUG',  # 调试级别
            'propagate': False,  # 不传播
        },
        'api.middleware': {  # API中间件日志记录器
            'handlers': ['debug_file'],  # 使用调试文件处理器
            'level': 'DEBUG',  # 调试级别
            'propagate': False,  # 不传播
        },
        'corsheaders': {  # CORS日志记录器
            'handlers': ['console'],  # 使用控制台处理器
            'level': 'WARNING',  # 警告级别
            'propagate': False,  # 不传播
        },
    },
}

