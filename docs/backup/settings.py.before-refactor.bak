            'format': '{levelname} {asctime} {module} {message}',  # 格式字符串
            'style': '{',  # 样式
        },
    },
    'handlers': {  # 日志处理器
        # 控制台只输出 INFO 以上，避免开发终端被逐请求的 DEBUG 刷屏
        'console': {  # 控制台处理器
            'level': 'INFO',  # 信息级别
            'class': 'logging.StreamHandler',  # 使用流处理器
            'formatter': 'verbose',  # 使用详细格式
        },
        # 应用日志：INFO 以上，单文件 10MB，保留 3 份
        'file': {  # 文件处理器
            'level': 'INFO',  # 信息级别
            'class': 'logging.handlers.RotatingFileHandler',  # 使用轮转文件处理器
            'filename': str(LOG_DIR / 'django.log'),  # 日志文件路径
            'maxBytes': 10 * 1024 * 1024,  # 单文件最大 10MB
            'backupCount': 3,  # 保留 3 个备份
            'encoding': 'utf-8',  # 编码
            'formatter': 'verbose',  # 使用详细格式
        },
        # 调试日志：DEBUG 以上，单文件 10MB，保留 3 份
