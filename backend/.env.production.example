# 生产环境参考配置（第 251 批）
# ⚠️ 这是**模板**，不是可直接提交的配置：复制成 .env 后按实际域名/证书/邮箱填写。
# 本地开发**不要**套用（DEBUG=False + HTTPS 跳转会让 http://127.0.0.1 打不开）。

# ---- 数据库（不配则本地 SQLite；生产建议 PostgreSQL）----
# 需要先装驱动：PostgreSQL 用 psycopg[binary]（或 requirements 里的 psycopg2），MySQL 用 mysqlclient
DATABASE_URL=postgres://crop:change-me@127.0.0.1:5432/crop_disease

# ---- 基础 ----
DJANGO_DEBUG=false
# 逗号分隔：你的域名（不要写 *）
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# 与前端实际访问的源一致（含协议与端口）
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# ---- HTTPS ----
# 反向代理（Nginx）终结 TLS 时开启；Django 侧只负责跳转与安全头
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# ---- 邮件（找回密码）----
# 现在没配 SMTP 时走控制台后端：重置链接会打进日志，生产必须换成真实 SMTP
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_HOST_USER=noreply@example.com
DJANGO_EMAIL_HOST_PASSWORD=change-me

# ---- 缓存（生产建议 Redis；未配置时回落到 LocMem，多进程下限流失效）----
DJANGO_CACHE_URL=redis://127.0.0.1:6379/1

# ---- 其他 ----
# 登录验证码（面向公网建议开）
DJANGO_LOGIN_CAPTCHA=true
DJANGO_REGISTER_CAPTCHA=true
