# ============================================================================
# 后端环境变量模板（第 82 批 · P0）
# ----------------------------------------------------------------------------
# 用法：
#   1) 复制成 .env：            copy .env.example .env      （Linux/macOS：cp）
#   2) 按需填写；**不要**把 .env 提交进版本库（.gitignore 已忽略）
#   3) 重启后端即生效：settings.py 会用标准库读这个文件（无需装 python-dotenv）
#
# 优先级：真实环境变量 > .env 文件 > 代码里的开发默认值。
# 也就是说部署时用 `set DJANGO_DEBUG=False` 传的值不会被 .env 覆盖。
#
# 想确认当前生效值：
#   python manage.py diffsettings | findstr /I "DEBUG SECRET_KEY ALLOWED_HOSTS"
# ============================================================================

# ── 安全（生产必填） ─────────────────────────────────────────────────────────
# 生产必须设为 False；为 True 时 Django 会在报错页暴露源码与配置
DJANGO_DEBUG=True

# 生产必填：DJANGO_DEBUG=False 时若不设置，程序会**直接拒绝启动**
# （避免带着公开的占位密钥对外服务）。生成方法：
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# 允许访问的域名/IP，逗号分隔。开发默认 *（本项目常在局域网内用手机访问）。
# 生产示例：DJANGO_ALLOWED_HOSTS=example.com,www.example.com,10.0.0.5
DJANGO_ALLOWED_HOSTS=*

# ── 跨域与 Cookie ────────────────────────────────────────────────────────────
# 允许任意来源跨域。默认与 DEBUG 一致（开发 True / 生产 False）。
DJANGO_CORS_ALLOW_ALL=True
# 只在 HTTPS 下发送会话与 CSRF Cookie。默认与 DEBUG 相反（生产 True）。
DJANGO_COOKIE_SECURE=False

# ── 生产安全开关（第 94 批） ─────────────────────────────────────────────────
# 这一组**默认跟随 DEBUG**：开发不用配，生产（DJANGO_DEBUG=False）自动切到安全的一侧。
# 内网 http 部署（没有证书）时，把 SSL 重定向与 Cookie Secure 显式设回 False 即可。
#
# 把 http 请求 301 到 https
# DJANGO_SECURE_SSL_REDIRECT=True
# HSTS：告诉浏览器"以后只用 https 访问我"。**默认关**，确认 HTTPS 稳定后再开；
# 开之前想清楚：浏览器会记住 max-age，回退很麻烦。
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
# 反代（Nginx/宝塔/云 LB）终止 TLS 时的转发头。不用反代就别开。
# DJANGO_USE_X_FORWARDED_HOST=True
# DJANGO_USE_X_FORWARDED_PORT=True

# 上传体积上限（Django 层，挡在解析请求体之前）
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
# DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# ── 静态与媒体文件（第 94 批） ───────────────────────────────────────────────
# 生产是否由 Django 自己托管 /media/（用户上传的图片）。
# 默认 = DEBUG：开发下托管，生产下交给 Nginx。
# 单机/内网小规模部署没配 Nginx 时，设 True 即可直接跑通（功能优先，性能其次）。
# DJANGO_SERVE_MEDIA=True
# 静态文件（admin 样式等）用 WhiteNoise 托管；装了 whitenoise 且非 DEBUG 时默认开。
# DJANGO_WHITENOISE=True

# ── Token 有效期（第 94 批真正生效） ─────────────────────────────────────────
# 单位秒，默认 604800（7 天）。**0 表示不过期**（仅开发图省事时用）。
# 注意：这个值以前只定义、没人读 —— 现在由 api/middleware.py 真正执行：
# 过期 Token 会被删除，请求按未认证处理（前端会跳登录页）。
# DJANGO_TOKEN_TTL_SECONDS=604800

# ── 缓存 / 限流（第 97 批）──────────────────────────────────────────────────
# ⚠️ 这一项不是"性能优化"，是**功能正确性**：
#    DRF 的限流计数存在 Django cache 里，而默认的 LocMemCache 是**进程内**的。
#    gunicorn 起 N 个 worker 时每个进程各算一份计数 —— 限额被放大 N 倍，
#    而且没有任何报错（接口看着正常，防护已经失效）。
#
# 生产请配一个共享缓存（Redis 最省事，见 requirements-prod.txt）：
# DJANGO_CACHE_URL=redis://127.0.0.1:6379/1
# 带密码 / TLS：
# DJANGO_CACHE_URL=rediss://:yourpassword@redis.example.com:6380/0
#
# 用 Memcached 或其它后端时指定后端类路径：
# DJANGO_CACHE_BACKEND=django.core.cache.backends.memcached.PyMemcacheCache
# DJANGO_CACHE_LOCATION=127.0.0.1:11211
#
# 开发/测试不必配：DEBUG 下自动用文件缓存，跑测试时用进程内缓存。
# 确认知悉"生产用 LocMemCache 的后果"、想关掉启动警告时：
# DJANGO_SUPPRESS_CACHE_WARNING=1

# ── 备份（第 102 批） ────────────────────────────────────────────────────────
# 备份根目录。默认是**项目根/backups**（不在 media 里面 —— 备份不能和要保护的数据
# 放在同一个目录，否则 media 被误删时备份一起没）。
#
# ⚠️ 生产请指向**另一块盘或网络存储**：和数据库同盘的备份，遇到磁盘故障就一起没了。
# DJANGO_BACKUP_DIR=D:\crop-backups
#
# 定时任务（Windows 用「任务计划程序」，见 docs/部署与运维.md）：
#   0 3    * * *  cd /path/to/backend && python manage.py backend_backup --keep 30 --quiet
#   30 3   * * *  cd /path/to/backend && python manage.py backup_verify --strict
#   0 4    * * *  cd /path/to/backend && python manage.py prune_media --yes --min-age-days 7
#
# 第 107 批补了第三条（清理 media 孤儿文件）：
#   · **必须加 `--yes`**，否则它只打印报告不删东西（危险操作默认干跑）；
#   · `--min-age-days 7` 是默认值，含义是"只清 7 天前就没有引用的文件" ——
#     正在上传、还没入库的文件看起来也像孤儿，不能和业务抢文件；
#   · 它会顺带清掉因此变空的目录，并把清单写到系统临时目录。
#
# ⚠️ 不挂这条任务不会立刻出事，但 media 会**只增不减**地长：
#    第 106 批实测清出了 791 个无引用文件 / 10.3 MB（占当时 media 的一半）。
#    根因（识别接口不写 annotated_image、同一张图写两遍）已经修了，
#    但"用户删掉的数据留下文件"这类情况仍会产生孤儿，需要有东西定期收。
#
# 恢复演练与完整流程见 docs/备份与恢复.md（第七节专门讲 prune_media）

# ── 邮箱 / 找回密码（可选） ──────────────────────────────────────────────────
# 不配置时走控制台后端：重置邮件直接打印在后端终端里，功能可完整跑通。
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=465
# DJANGO_EMAIL_HOST_USER=no-reply@example.com
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com
# 重置链接有效期（秒），默认 3600
# PASSWORD_RESET_TIMEOUT=3600

# ── 其它 ─────────────────────────────────────────────────────────────────────
# 前端地址（邮件里的重置链接会用到），默认 http://127.0.0.1:5173
# FRONTEND_BASE_URL=http://127.0.0.1:5173

# ── 用户内容的机器翻译（第 85/86 批） ───────────────────────────────────────
# 论坛帖子/评论、意见反馈都是用户写的中文，英文界面下需要译文。provider 可选：
#   mymemory（默认，免 key 公共接口，有每日额度，适合开发/演示）
#   deepl   （DeepL 官方，质量最好之一，需 TRANSLATE_API_KEY）
#   baidu   （百度翻译开放平台，国内网络可直连，需 TRANSLATE_APP_ID + KEY）
#   openai  （OpenAI 兼容 /chat/completions，需 URL + KEY + MODEL）
#   libre   （LibreTranslate 兼容接口，可自建离线部署，需 TRANSLATE_API_URL）
#   none    （关闭自动翻译，只保留人工填写译文 —— 发帖完全不受影响）
#
# 换好之后先自检，再一键重刷已有译文：
#   python manage.py translate_provider_check              # 通不通 / 缺什么配置
#   python manage.py translate_provider_check --all         # 列出全部 provider 与所需配置
#   python manage.py translate_forum_content --force        # 按新 provider 重刷机器译文
#     （--force 不会动作者/管理员手工写的英文；要覆盖它们得显式 --force-manual）
TRANSLATE_ENABLED=True
TRANSLATE_PROVIDER=mymemory

# MyMemory：填了邮箱可把匿名额度从 5000 字/天提到 50000 字/天（可选）
# TRANSLATE_CONTACT_EMAIL=

# DeepL（免费版 key 以 :fx 结尾，会自动走 api-free.deepl.com）
# TRANSLATE_PROVIDER=deepl
# TRANSLATE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# TRANSLATE_TARGET_LANG=EN-US

# 百度翻译开放平台（国内直连）
# TRANSLATE_PROVIDER=baidu
# TRANSLATE_APP_ID=20240101000000000
# TRANSLATE_API_KEY=xxxxxxxxxxxxxxxx

# OpenAI 兼容（DeepSeek / 通义 / Moonshot / 本地 vLLM 等）
# TRANSLATE_PROVIDER=openai
# TRANSLATE_API_URL=https://api.deepseek.com/v1
# TRANSLATE_API_KEY=sk-xxxxxxxx
# TRANSLATE_MODEL=deepseek-chat

# LibreTranslate（自建）
# TRANSLATE_PROVIDER=libre
# TRANSLATE_API_URL=https://your-libretranslate.example.com
# TRANSLATE_API_KEY=

# 单次请求超时（秒）
# TRANSLATE_TIMEOUT=8
# 译文后处理术语表（纠正公共接口把"早疫病"译成 Premature Disease 之类）；换 DeepL/OpenAI 后可关
# TRANSLATE_GLOSSARY=True

# 关闭它则发帖/评论时**不同步翻译**，改用：
#   python manage.py translate_forum_content        # 批量补译
# TRANSLATE_ON_WRITE=True

# ============================================================================
# 智能回答助手（LLM）—— 第 204 批补进本文件
# ----------------------------------------------------------------------------
# ⚠️ 这些配置**此前只在代码注释里**，`git clone` 下来的人看不到该配哪些，
#    于是"助手为什么不回答"往往要翻源码才知道。补在这里。
#
# 语料：docs/knowledge_base/作物病害知识库_校准版.json（38 条 × 7 维度，已入库）
# 设计：docs/智能回答助手框架.md        入库：docs/知识库入库方案.md
#
# ⚠️ 这一组**刻意独立于 TRANSLATE_***：助手与翻译各有自己的降级策略 ——
#    翻译挂了只是没有英文，助手挂了要降级成"词条原文"。
# ============================================================================

#: 总开关。默认**关**（与 TRANSLATE_ENABLED 默认 True 相反）：助手要花钱，
#: 没配 key 时打开只会让每次提问都走一遍降级链路。**不起作用时界面会显示档案原文**，
#: 不是报错 —— 这是刻意设计（见 docs/智能回答助手框架.md）。
LLM_ENABLED=True

#: OpenAI 兼容端点（DeepSeek / 通义 / Moonshot / 本地 vLLM 都行）
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#: ⚠️ `LLM_MODEL` **不保证精确选型**：实测请求 `deepseek-chat` 时，
#:    响应体的 model 字段是 `deepseek-flash`（端点侧重定向）。
#:    实到的模型会记进 `AssistantMessage.model`，事后可查。
LLM_MODEL=deepseek-chat

#: 单次生成超时（秒）。长回答（跨两个词条）需要 8~15 秒，留足余量。
LLM_TIMEOUT=30

#: 单次生成的最大输出 token。中文约 1 字 ≈ 1 token。
#: ⚠️ 调小会导致**回答被截在半句话**（界面上会提示"回答可能不完整"，
#:    库里 `AssistantMessage.truncated=True`）—— 这是第 204 批踩过的坑：
#:    800 时"苹果跟葡萄"这类跨词条问题会被截断。
#:    第 209 批从 2000 提到 2500：用户会问"某作物的**所有**病害"，
#:    8 条清单（约 1450 字）要留足余量。
LLM_MAX_TOKENS=2500

#: 单个会话最多多少条消息（到顶建议新开会话，不做摘要压缩）
ASSISTANT_SESSION_MAX_MESSAGES=50

#: 多轮对话带几轮历史进模型（第 228 批；0 = 不带，只看当前问题）。
#: 一轮 = 一条用户消息 + 一条助手回答；历史另有 1200 字总预算（见 prompts.HISTORY_TOTAL_CHARS）。
ASSISTANT_HISTORY_TURNS=4

#: 每用户每分钟提问上限（0 = 不限）。闸门在**动模型之前**执行，所以拒绝不花额度。
ASSISTANT_RATE_PER_MINUTE=10

#: 单次检索取几条进上下文。
#: ⚠️ 第 209 批从 5 提到 8：用户会问"苹果跟葡萄的所有病害"这类**按作物清点**的问题，
#:    苹果 4 条 + 葡萄 4 条 = 8 条 —— 取 5 条时模型根本看不到另外 3 条，
#:    提示词写得再好也只能答出一部分（这是"答案不完整"的硬约束）。
#:    单一病害问题不会被这个值拖累：`orchestrator._trim_dominated_hits()` 会在
#:    **有明确主角**时（最高分远超其余，如 104 : 34）丢掉弱命中，只留真正相关的那条。
ASSISTANT_TOP_K=8
